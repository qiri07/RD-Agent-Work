# 环境变量模板 — 请勿将此文件提交到版本控制
# 实际配置请复制为 .env 并填入真实值

# LiteLLM / AI 后端配置
LITELLM_CHAT_MODEL=openai/agnes-2.5-flash
LITELLM_OPENAI_API_KEY=your_api_key_here
LITELLM_CHAT_OPENAI_BASE_URL=https://apihub.agnes-ai.cn/v1
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend

# 飞书 Webhook（可选）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
# FEISHU_PROJECT_NAME=RD-Agent 因子分析
